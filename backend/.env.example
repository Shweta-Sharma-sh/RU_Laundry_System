# Copy this file to .env and change the values.

# The PostgreSQL database.
DATABASE_URL=postgres://localhost:5432/ru_laundry

# The port the API listens on.
PORT=4000

# The address of the frontend (allowed to call the API).
FRONTEND_URL=http://localhost:3000

# The secret that signs the QR codes. Make it long and random, and never share it.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
QR_SECRET=change-me-to-a-long-random-secret

# The time zone of the laundry counter (used for opening hours).
TIMEZONE=Asia/Kolkata

# Set to true only on a demo server. It lets an admin wipe the database.
ALLOW_DEMO_RESET=false

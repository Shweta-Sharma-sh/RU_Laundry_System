{
  "name": "ru-laundry-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Backend (REST API + PostgreSQL) for the RU Laundry System",
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "db:setup": "node --env-file-if-exists=.env database/setup.js",
    "test": "node --env-file-if-exists=.env --test --test-concurrency=1 tests/"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "pg": "^8.16.3"
  },
  "engines": {
    "node": ">=22"
  }
}
